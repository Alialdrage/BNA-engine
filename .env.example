# انسخ هذا الملف إلى .env.local وضع المفتاح فيه.
# بدونه يعمل المحرك بوضع القواعد (بدون ذكاء اصطناعي).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# مفتاح Gemini (Google AI Studio) لمحركي Gemini 4 و Gemini 3.8
GEMINI_API_KEY=
# معرفات النماذج (اختياري). الافتراضي من صفحة Google الرسمية
GEMINI4_MODEL=gemini-4-argon
GEMINI38_MODEL=gemini-3.8-flash
# عدد طلبات الذكاء الاصطناعي المسموحة لكل IP في الدقيقة (الافتراضي 10)
AI_RATE_LIMIT_PER_MINUTE=10
# عدد طلبات توليد الصور لكل IP في الدقيقة (الافتراضي 12)
IMAGE_RATE_LIMIT_PER_MINUTE=12
# البحث في الويب (كل عملية بحث لها تكلفة)
WEB_RATE_LIMIT_PER_HOUR=20
WEB_SEARCH_MAX_USES=5
DEEP_RESEARCH_MAX_USES=12
